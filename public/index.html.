
<script>
const $ = s => document.querySelector(s);

let platform = "tiktok";
let style = "Viral";

document.querySelectorAll(".platform").forEach(b => {
  b.onclick = () => {
    document.querySelectorAll(".platform").forEach(x =>
      x.classList.remove("active")
    );
    b.classList.add("active");
    platform = b.dataset.platform;

    $("#previewBadge").textContent =
      (platform === "tiktok" ? "TIKTOK" : "SHOPEE") + " • 9:16";

    $("#guideTitle").textContent =
      platform === "tiktok" ? "Panduan TikTok" : "Panduan Shopee";

    $("#guideText").textContent =
      platform === "tiktok"
      ? "Gunakan hook kuat, tampilkan produk, lalu tutup dengan CTA natural."
      : "Fokus pada manfaat, detail produk, dan bukti penggunaan.";
  };
});

document.querySelectorAll(".style").forEach(b => {
  b.onclick = () => {
    document.querySelectorAll(".style").forEach(x =>
      x.classList.remove("active")
    );
    b.classList.add("active");
    style = b.textContent;
    $("#previewTitle").textContent = style + " — review produk realistis.";
  };
});

$("#generate").onclick = async () => {
  const imageUrl = $("#imageUrl").value.trim();
  const productName =
    $("#productName").value.trim() || "affiliate product";

  if (!/^https:\/\//i.test(imageUrl)) {
    $("#status").textContent =
      "Masukkan URL gambar produk HTTPS yang valid.";
    return;
  }

  const button = $("#generate");
  const fill = $("#fill");
  const result = $("#result");

  button.disabled = true;
  result.style.display = "none";
  result.replaceChildren();
  fill.style.width = "5%";
  $("#status").textContent = "Menghubungkan ke AI GlassAffili...";

  try {
    const prompt = [
      "Create a realistic vertical 9:16 UGC affiliate product video.",
      "Product: " + productName + ".",
      "Style: " + style + ".",
      "Platform: " + platform + ".",
      "Show a realistic Indonesian content creator holding, demonstrating",
      "and naturally using the product when appropriate.",
      "Use natural lighting, realistic hands, smooth camera movement,",
      "authentic product details and professional social media quality.",
      "Keep the product appearance consistent with the reference image.",
      "No fake text, no logos added, no distorted product."
    ].join(" ");

    const response = await fetch("/api/jobs", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ imageUrl, productName, style, platform, prompt })
    });

    const job = await response.json();

    if (!response.ok) {
      throw new Error(job.error || "Gagal mengirim permintaan video.");
    }

    if (!job.id) {
      throw new Error("ID proses video tidak ditemukan.");
    }

    $("#status").textContent = "AI sedang membuat video...";
    let attempts = 0;

    while (attempts < 240) {
      await new Promise(resolve => setTimeout(resolve, 3000));
      attempts++;

      const check = await fetch(
        "/api/jobs/" + encodeURIComponent(job.id)
      );

      const data = await check.json();

      if (!check.ok) {
        throw new Error(data.error || "Gagal mengecek proses video.");
      }

      const progress = Math.min(95, 10 + attempts * 2);
      fill.style.width = progress + "%";

      if (data.status === "succeeded") {
        const videoUrl = Array.isArray(data.videoUrl)
          ? data.videoUrl[0]
          : data.videoUrl;

        if (!videoUrl) {
          throw new Error("Video selesai tetapi URL tidak ditemukan.");
        }

        fill.style.width = "100%";
        $("#status").textContent = "Video berhasil dibuat! 🎉";

        const video = document.createElement("video");
        video.src = videoUrl;
        video.controls = true;
        video.playsInline = true;
        video.style.width = "100%";
        video.style.borderRadius = "16px";
        video.style.marginBottom = "12px";

        const link = document.createElement("a");
        link.href = videoUrl;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = "▶ Buka / Download Video";

        result.append(video, link);
        result.style.display = "block";
        return;
      }

      if (data.status === "failed" || data.status === "canceled") {
        throw new Error(data.error || "Proses pembuatan video gagal.");
      }

      $("#status").textContent =
        data.status === "starting"
        ? "AI sedang menyiapkan video..."
        : "AI sedang menghasilkan video... (" + attempts * 3 + " detik)";
    }

    throw new Error("Waktu tunggu habis. Coba cek kembali nanti.");

  } catch (error) {
    $("#status").textContent = "Error: " + error.message;
    fill.style.width = "0%";
  } finally {
    button.disabled = false;
  }
};
</script>
</body>
</html>
